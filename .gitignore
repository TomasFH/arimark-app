# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-electron/
release/
out/
apps/mobile/dist/

# Environment variables — NEVER commit secrets
.env
.env.*
!.env.example

# Config por cliente — contiene datos específicos del negocio, no se versiona
config/business.json
apps/desktop/config/business.json

# SQLite databases — production data never in repo
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Dump local de catálogo con precios reales (no versionar)
apps/desktop/scripts/catalog-backup-*.txt

# Drizzle cache
**/drizzle/.cache

# Logs
userData/
*.log
firebase-debug.log
firestore-debug.log

# Lock files from other package managers — pnpm only
package-lock.json
yarn.lock

# OS
.DS_Store
Thumbs.db
nul

# Editor
.vscode/settings.json
.idea/

# Electron builder
.cache/

