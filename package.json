{
  "name": "carniceria-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @carniceria/desktop dev",
    "dev:hw": "pnpm --filter @carniceria/desktop dev:hw",
    "dev:prod": "pnpm --filter @carniceria/desktop dev:prod",
    "electron:remote": "pnpm --filter @carniceria/desktop electron:remote",
    "electron:remote:reset": "pnpm --filter @carniceria/desktop electron:remote:reset",
    "backfill:sync": "pnpm --filter @carniceria/desktop firestore:backfill-sync",
    "build:prod": "pnpm --filter @carniceria/desktop build:prod",
    "seed:dev": "pnpm --filter @carniceria/desktop seed:dev",
    "seed:prod": "pnpm --filter @carniceria/desktop seed:prod",
    "mobile:dev": "pnpm --filter @carniceria/mobile dev",
    "mobile:build": "pnpm --filter @carniceria/mobile build",
    "mobile:deploy": "pnpm --filter @carniceria/mobile build && npx firebase-tools deploy --only hosting,firestore:rules",
    "mobile:cap:sync": "pnpm --filter @carniceria/mobile cap:sync",
    "mobile:cap:android": "pnpm --filter @carniceria/mobile cap:open:android",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
