rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Activación de equipos: fuera de la 1.0. No abre datos operativos.
    // activity_log ya no la usa.
    function isActiveInstallation(licenseKey) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/licenses/$(licenseKey)/installations/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/licenses/$(licenseKey)/installations/$(request.auth.uid)).data.status == 'active';
    }

    function signedIn() {
      return request.auth != null;
    }

    function userPath(licenseKey) {
      return /databases/$(database)/documents/licenses/$(licenseKey)/users/$(request.auth.uid);
    }

    // active ausente cuenta como habilitado. Leer .active si no está tira error.
    // active == false no entra. butcher no entra: solo admin o cashier. Sin filtro por local.
    function accountEnabled(data) {
      return !data.keys().hasAny(['active']) || data.active != false;
    }

    function isActiveMember(licenseKey) {
      return signedIn()
        && exists(userPath(licenseKey))
        && accountEnabled(get(userPath(licenseKey)).data)
        && (get(userPath(licenseKey)).data.role == 'admin'
            || get(userPath(licenseKey)).data.role == 'cashier');
    }

    function isAdmin(licenseKey) {
      return isActiveMember(licenseKey)
        && get(userPath(licenseKey)).data.role == 'admin';
    }

    function isCashier(licenseKey) {
      return isActiveMember(licenseKey)
        && get(userPath(licenseKey)).data.role == 'cashier';
    }

    // Lo que no cambia al confirmar o cancelar una transferencia.
    function transferSameMovement() {
      return request.resource.data.productName == resource.data.productName
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.fromStoreId == resource.data.fromStoreId
        && request.resource.data.toStoreId == resource.data.toStoreId
        && request.resource.data.occurredAt == resource.data.occurredAt
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.estimatedValue == resource.data.estimatedValue
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.deleted == false;
    }

    function transferCreate(licenseKey) {
      return isActiveMember(licenseKey)
        && request.resource.data.status == 'pending'
        && request.resource.data.receivedQuantity == null
        && request.resource.data.hasDifference == false
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
        && request.resource.data.deleted == false
        && request.resource.data.fromStoreId is string
        && request.resource.data.toStoreId is string
        && request.resource.data.fromStoreId != request.resource.data.toStoreId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.unit in ['kg', 'u', 'cajon'];
    }

    function transferConfirm(licenseKey) {
      return isActiveMember(licenseKey)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.receivedQuantity is number
        && request.resource.data.receivedQuantity >= 0
        && request.resource.data.hasDifference == (request.resource.data.receivedQuantity != resource.data.quantity)
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.confirmedAt is string
        && transferSameMovement();
    }

    function transferCancel(licenseKey) {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.receivedQuantity == null
        && request.resource.data.hasDifference == false
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
        && transferSameMovement()
        && (request.auth.uid == resource.data.createdBy || isAdmin(licenseKey));
    }

    // Plata de la ficha, más las horas que se sellan junto con ella.
    // cashLeft y deliveredAmount no están: los sigue escribiendo quien cierra.
    function fichaMoneyKeys() {
      return [
        'soldTotal',
        'cashTotal',
        'cardWalletTotal',
        'debitTotal',
        'walletTotal',
        'creditTotal',
        'debtTotal',
        'expenseTotal',
        'contributionTotal',
        'walletCashTotal',
        'soldHoursJson',
        'moneySnapshottedAt',
        'providerExpenseTotal'
      ];
    }

    // Ausente, o presente pero no es un string (null): todavía no se selló.
    function fichaUnsealed() {
      return resource.data.keys().hasAny(['moneySnapshottedAt']) == false
        ? true
        : (resource.data.moneySnapshottedAt is string) == false;
    }

    // affectedKeys no incluye claves que se reenvían con el mismo valor,
    // aunque el documento tenga otros campos en null.
    function fichaMoneyUntouched() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(fichaMoneyKeys()) == false;
    }

    function cashierMayUpdateShift(licenseKey) {
      return isCashier(licenseKey)
        && (fichaUnsealed() || fichaMoneyUntouched());
    }

    // La cajera lee y escribe sueldos/vales de un turno (shiftId string).
    // El admin lista la colección sin ese filtro. shiftId ausente no es error.
    function hasShiftId(data) {
      return data.get('shiftId', '') != '';
    }

    // -----------------------------------------------------------------------
    // Licencia — legible por cualquier sesión autenticada, anónima incluida.
    // No es un dato operativo.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /licenses/{licenseKey}/stores/{storeId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    // Instalaciones: sin cambios. La activación de equipos queda fuera de la 1.0.
    match /licenses/{licenseKey}/installations/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // El propio uid puede leer su perfil (login, también butcher).
    // Escribir perfiles: admin activo. Nadie borra en duro.
    match /licenses/{licenseKey}/users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin(licenseKey);
      allow create, update: if isAdmin(licenseKey);
      allow delete: if false;
    }

    // Alta de la cajera o el admin, sin equipo activado. El admin lee.
    // Nadie modifica ni borra.
    match /licenses/{licenseKey}/activity_log/{entry} {
      allow create: if isActiveMember(licenseKey);
      allow read: if isAdmin(licenseKey);
      allow update, delete: if false;
    }

    match /licenses/{licenseKey}/catalog/{storeId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read, create, update: if isActiveMember(licenseKey);
        allow delete: if false;
      }
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/sales/{saleId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/expenses/{expenseId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/cebo/{entryId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/merch/{entryId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/vales/{valeId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/salaryPayments/{paymentId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/providers/{providerId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/providerDebtEvents/{eventId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/providerDebtCheckpoints/{checkpointId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/shifts/{shiftId} {
      allow read, create: if isActiveMember(licenseKey);
      allow update: if isAdmin(licenseKey) || cashierMayUpdateShift(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sales/{saleId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/expenses/{expenseId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/ceboEntries/{entryId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/merchandiseIntakes/{entryId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/merchandiseIntakeRubros/{rubroId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/providerPurchasePrices/{providerId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/employees/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/attendance/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/employeeVales/{id} {
      allow read: if isAdmin(licenseKey)
        || (isCashier(licenseKey) && hasShiftId(resource.data));
      allow create, update: if isAdmin(licenseKey)
        || (isCashier(licenseKey) && hasShiftId(request.resource.data));
      allow delete: if false;
    }

    match /licenses/{licenseKey}/salaryPayments/{id} {
      allow read: if isAdmin(licenseKey)
        || (isCashier(licenseKey) && hasShiftId(resource.data));
      allow create, update: if isAdmin(licenseKey)
        || (isCashier(licenseKey) && hasShiftId(request.resource.data));
      allow delete: if false;
    }

    match /licenses/{licenseKey}/stockCounts/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/orders/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/customers/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/customerDebtEvents/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/customerDebtCheckpoints/{checkpointId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/debtCheckpointTails/{tailId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/ops/{docId} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/specialCustomers/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    match /licenses/{licenseKey}/specialCustomerPrices/{id} {
      allow read, create, update: if isActiveMember(licenseKey);
      allow delete: if false;
    }

    // Movimiento entre locales. No es una compra, un gasto ni una deuda.
    // Confirmar: cualquier cajera o admin, solo si sigue pendiente.
    // Cancelar: quien la creó, o un admin, solo si sigue pendiente.
    match /licenses/{licenseKey}/storeTransfers/{id} {
      allow read: if isActiveMember(licenseKey);
      allow create: if transferCreate(licenseKey);
      allow update: if transferConfirm(licenseKey) || transferCancel(licenseKey);
      allow delete: if false;
    }
  }
}
