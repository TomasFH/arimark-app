rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Función helper: verifica que el UID anónimo está activo en installations
    // -----------------------------------------------------------------------
    function isActiveInstallation(licenseKey) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/licenses/$(licenseKey)/installations/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/licenses/$(licenseKey)/installations/$(request.auth.uid)).data.status == 'active';
    }

    // -----------------------------------------------------------------------
    // Licencias — legible por cualquier usuario autenticado (anónimo incluido).
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Locales — solo lectura para instalaciones activas de esa licencia
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/stores/{storeId} {
      allow read: if isActiveInstallation(licenseKey);
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Instalaciones — solo escritura del propio UID (activación inicial)
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/installations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if false; // Solo via Cloud Function
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Perfiles de usuario (cajeras y admins).
    //
    // - Cada usuario puede leer su propio perfil (login).
    // - Admins pueden leer y escribir TODOS los perfiles de su licencia
    //   (para listar cajeras, crear, activar/desactivar, soft-delete).
    //
    // Alta/baja manual desde consola hasta que exista panel admin (Fase 4).
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/users/{uid} {
      // El propio usuario puede leer su perfil (para el flujo de login)
      allow read: if request.auth != null && request.auth.uid == uid;
      // Admins pueden leer y escribir todos los perfiles de la licencia
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/licenses/$(licenseKey)/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -----------------------------------------------------------------------
    // Activity log — solo escritura (append-only)
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/activity_log/{entry} {
      allow create: if isActiveInstallation(licenseKey);
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Catálogo de productos por local.
    // Escrito por la PC (proceso main, usuario autenticado con Firebase Auth).
    // Leído por la PWA móvil cuando el usuario está autenticado.
    //
    // DEUDA TÉCNICA: gating fino (verificar que el uid pertenece a la licencia
    // y tiene authorizedStores que incluya storeId) se implementa en Fase 4
    // cuando exista el panel admin de precios por local.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/catalog/{storeId} {
      allow read, write: if request.auth != null;
    }

    // -----------------------------------------------------------------------
    // Staging de turnos y ventas del celular para importación a la PC.
    //
    // - read:   permite que la PC (via onSnapshot) y la PWA (para marcar
    //           syncedAt localmente) lean.
    // - create: la PWA crea nuevos documentos (UUID de turno / venta).
    // - update: la PWA marca syncedAt; la PC marca importedAt.
    // - delete: no permitido — los docs son inmutables una vez creados.
    //
    // DEUDA TÉCNICA: verificar que el uid del token pertenece a la licencia
    // y al storeId dado (requiere Fase 4).
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /licenses/{licenseKey}/sync/{storeId}/shifts/{shiftId}/sales/{saleId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Proveedores — entidades globales sincronizadas entre PCs (Fase S1).
    //
    // - read/write: cualquier usuario autenticado de la licencia (cajera o admin).
    //   La PC desktop escribe (push con setDoc/merge) cuando syncedAt=null.
    //   Todas las PCs leen via onSnapshot para mantener el cache local fresco.
    //
    // DEUDA TÉCNICA: gating fino (verificar uid pertenece a la licencia) cuando
    // exista panel admin en Fase 4. Hoy todos los auth'd de la licencia acceden.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/providers/{providerId} {
      allow read, write: if request.auth != null;
    }

    // -----------------------------------------------------------------------
    // Eventos de deuda a proveedores — append-only desde la PC del local.
    //
    // - read: cualquier usuario autenticado de la licencia (admin para vista combinada).
    // - write: cualquier usuario autenticado de la licencia (cajera registra gastos).
    // - delete: no permitido — ledger de eventos es inmutable.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/providerDebtEvents/{eventId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Turnos operativos (sync PC → Firestore, lectura admin remota — TASKS_V1 B1).
    // Path: licenses/{key}/shifts/{shiftId}
    // Distinto del staging móvil en sync/{storeId}/shifts.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/shifts/{shiftId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Ventas operativas (sync PC → Firestore — TASKS_V1 B2).
    // Documento embebido con items[] y payments[].
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/sales/{saleId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Gastos operativos (sync PC → Firestore — TASKS_V1 B3).
    // Soft-delete vía update (deleted:true); hard delete prohibido.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/expenses/{expenseId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Empleados / asistencia / vales / salarios / conteos (TASKS_V1 D/E/F).
    // Reglas anticipadas: auth requerido; hard delete prohibido.
    // -----------------------------------------------------------------------
    match /licenses/{licenseKey}/attendance/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /licenses/{licenseKey}/employeeVales/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /licenses/{licenseKey}/salaryPayments/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /licenses/{licenseKey}/stockCounts/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
