{
  "name": "@carniceria/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos y utilidades compartidas entre desktop y mobile",
  "main": "./src/index.ts",
  "files": [
    "src",
    "dist-cjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist-cjs/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  }
}
