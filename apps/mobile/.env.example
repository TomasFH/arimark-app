# Variables de entorno de la PWA móvil
# Copiar este archivo como .env y completar con los valores reales de Firebase.
# NUNCA commitear el archivo .env con datos reales.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de licencia del negocio (single-tenant por build)
VITE_LICENSE_KEY=
